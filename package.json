{
  "name": "agent-router-ua",
  "version": "0.2.0",
  "description": "请求头注入插件：按 host 规则注入 HTTP 请求头（多条规则各自独立头集合，同名头覆盖原值，默认 agentrouter.org → User-Agent: RooCode/0.15.0），绕过目标站点客户端 WAF 拦截；其余请求零影响",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "gates": "node scripts/gates.mjs",
    "prepack": "npm run bundle && npm run gates"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "*",
    "react": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
